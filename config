ngx_addon_name=ngx_http_waf_module

ngx_http_waf_rust_dir="$ngx_addon_dir/rust"
ngx_http_waf_include="$ngx_addon_dir/include"
ngx_http_waf_srcs="$ngx_addon_dir/src/ngx_http_waf_module.c"
ngx_http_waf_deps="$ngx_addon_dir/include/ngx_http_waf_ffi.h"

#
# The business logic lives in the Rust crate, the C file above is only glue.
# Build the static library here, at configure time, so that nginx's `make` and
# the dynamic module link step can just pick it up.
#

if [ -z "$ngx_http_waf_cargo" ]; then
    ngx_http_waf_cargo="${CARGO:-cargo}"
fi

if ! command -v "$ngx_http_waf_cargo" > /dev/null 2>&1 ; then
    cat << END
$0: error: the $ngx_addon_name module needs the Rust toolchain, but the
command [$ngx_http_waf_cargo] was not found.  Install it from
https://rustup.rs/ or set CARGO to its path.
END
    exit 1
fi

ngx_http_waf_profile="${NGX_WAF_CARGO_PROFILE:-release}"
ngx_http_waf_target_dir="${NGX_WAF_TARGET_DIR:-$ngx_http_waf_rust_dir/target}"

ngx_http_waf_cargo_args="--manifest-path $ngx_http_waf_rust_dir/Cargo.toml
    --profile $ngx_http_waf_profile
    --target-dir $ngx_http_waf_target_dir
    $NGX_WAF_CARGO_FLAGS"

# A dynamic module must be position independent, including the Rust objects.
if [ "$ngx_module_link" = "DYNAMIC" ]; then
    RUSTFLAGS="$RUSTFLAGS -C relocation-model=pic"
    export RUSTFLAGS
fi

echo " + building the Rust core ($ngx_http_waf_profile)"
if ! $ngx_http_waf_cargo build $ngx_http_waf_cargo_args ; then
    cat << END
$0: error: the Rust core of the $ngx_addon_name module failed to build.
END
    exit 1
fi

ngx_http_waf_lib_dir="$ngx_http_waf_target_dir/$ngx_http_waf_profile"

if [ ! -f "$ngx_http_waf_lib_dir/libngx_waf_core.a" ]; then
    cat << END
$0: error: [$ngx_http_waf_lib_dir/libngx_waf_core.a] is missing after the
cargo build, check the configuration of the Rust crate.
END
    exit 1
fi

ngx_http_waf_module_libs=" -L $ngx_http_waf_lib_dir -l ngx_waf_core -l pthread -l dl -l m "
ngx_http_waf_module_inc_path=" $ngx_http_waf_include "

#
# The Rust core talks to libmodsecurity through its C API, so nginx has to
# link against the library.
#
if [ -n "$LIB_MODSECURITY" ]; then
    ngx_http_waf_module_libs="$ngx_http_waf_module_libs -L $LIB_MODSECURITY/lib -l modsecurity "
    ngx_http_waf_module_inc_path="$ngx_http_waf_module_inc_path $LIB_MODSECURITY/include "
else
    ngx_http_waf_module_libs="$ngx_http_waf_module_libs -l modsecurity "
fi

ngx_feature="modsecurity library"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_path=$ngx_http_waf_module_inc_path
ngx_feature_incs=$(cat << END
#include <modsecurity/modsecurity.h>
#include <modsecurity/transaction.h>
END
)
ngx_feature_libs=$ngx_http_waf_module_libs
ngx_feature_test=
. auto/feature
if [ $ngx_found = no ] ; then
    cat << END
$0: error: the $ngx_addon_name module requires the $ngx_feature.
END
    exit 1
fi

#
# The client that reaches a captcha provider uses the TLS machinery of nginx
# (`ngx_ssl_create()`, `ngx_ssl_handshake()`) and the glue holds an `ngx_ssl_t`,
# so the tree has to be configured with SSL support.  The C implementation
# reached the provider with libcurl and did not need it.
#
if [ "$USE_OPENSSL" != "YES" ]; then
    cat << END
$0: error: the $ngx_addon_name module needs an nginx built with SSL support,
add --with-http_ssl_module to the configure options of nginx.
END
    exit 1
fi

ngx_feature=
ngx_feature_name=
ngx_feature_run=
ngx_feature_path=
ngx_feature_incs=
ngx_feature_libs=
ngx_feature_test=


if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP_AUX_FILTER
    ngx_module_name=$ngx_addon_name
    ngx_module_deps="$ngx_http_waf_deps"
    ngx_module_incs="$ngx_http_waf_module_inc_path"
    ngx_module_srcs="$ngx_http_waf_srcs"
    ngx_module_libs="$ngx_http_waf_module_libs"

    . auto/module
else
    HTTP_AUX_FILTER_MODULES="$HTTP_AUX_FILTER_MODULES ${ngx_addon_name}"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $ngx_http_waf_deps"
    HTTP_INCS="$HTTP_INCS -I $ngx_http_waf_include"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_http_waf_srcs"
    ngx_module_libs="$ngx_http_waf_module_libs"
fi
